# Shared, public settings. The backend reads this file directly, so there is nothing to copy.
# Project: Meowza (Supabase dashboard > Project Settings > API Keys)
SUPABASE_URL=https://sahiipjghvlzgtatgsis.supabase.co

# Publishable key (sb_publishable_...). It is public on purpose: row-level security decides what it
# can do. The backend signs in as an anonymous user and keeps the session in
# backend/.supabase-session.json, so you can only change or delete the flags, votes and projects you made.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_P035Rrj8XKMHCanSCRaDWw_f7Ro7RQa

# Private overrides go in backend/.env (git-ignored, optional), which wins over this file.
# Project owners only: SUPABASE_SECRET_KEY=sb_secret_... there bypasses RLS. Never put it in this file.
